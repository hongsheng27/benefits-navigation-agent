# Shared editor settings so four people on four setups produce identical files.
# Supported natively by VS Code, JetBrains, and Kiro.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false
