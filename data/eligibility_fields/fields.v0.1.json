      "purpose": "所在縣市決定有哪些地方型補助與受理窗口可對照",
      "used_by": [
        "funeral_benefit",
        "survivor_pension",
        "occupational_injury_recognition",
        "unemployment_benefit"
      ],
      "topic_id": "location",
      "status": "draft"
    },
    {
      "field_id": "involuntary_job_loss",
      "value_kind": "boolean",
      "option_ids": [],
      "required": true,
      "purpose": "非自願離職才是失業給付常見門檻之一",
      "used_by": ["unemployment_benefit"],
      "topic_id": "employment_status",
      "status": "draft"
    },
    {
      "field_id": "deceased_insurance_type",
      "value_kind": "code",
      "option_ids": [
        "labor_insurance",
        "national_pension",
        "farmers_insurance",
        "civil_service_insurance",
        "none_or_unsure"
      ],
      "required": true,
      "purpose": "投保身分決定由哪個機關受理，以及適用哪一套給付規則",
