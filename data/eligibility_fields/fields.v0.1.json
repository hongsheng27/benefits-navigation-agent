      "required": true,
      "purpose": "目前照顧分工用來整理喘息、家庭照顧者支持與人工協助方向",
      "used_by": ["caregiver_support_services", "caregiver_support_contact"],
      "topic_id": "caregiver_situation",
      "status": "draft"
    },
    {
      "field_id": "caregiver_employment_impact",
      "value_kind": "code",
      "option_ids": [
        "left_job",
        "reduced_hours",
        "no_employment_change",
        "considering_employment_change"
      ],
      "required": true,
      "purpose": "照顧對工作的影響用來判斷是否整理就業支持方向",
      "used_by": ["caregiver_employment_support"],
      "topic_id": "caregiver_situation",
      "status": "draft"
