  "discovery_rules": [
    {
      "id": "high_precision_phrase",
      "when": "Matches a high_precision_phrases term.",
      "result": "primary_subsidy_candidate",
      "priority": "high"
    },
    {
      "id": "event_and_subsidy",
      "when": "Matches at least one event_terms term and one subsidy_terms term.",
      "result": "primary_subsidy_candidate",
      "priority": "normal"
    },
    {
      "id": "adjacent_financial_phrase",
      "when": "Matches an adjacent_financial_phrases term.",
      "result": "adjacent_financial_resource",
      "priority": "separate_review"
    },
    {
      "id": "single_broad_term",
      "when": "Matches only one broad event_terms or subsidy_terms term.",
      "result": "insufficient_signal",
      "priority": "none"
    },
    {
      "id": "noise_signal",
      "when": "Matches a noise_terms term.",
      "result": "lower_review_priority",
      "priority": "lower",
      "note": "A noise term alone must not automatically reject a page."
    }
  ],
  "review_constraints": [
    "Keyword matches create candidates only.",
    "Do not infer current availability, eligibility, or organization responsibility from keywords.",
    "Require official-source and evidence review before publishing a program.",
    "Keep uncertain candidates instead of treating missing evidence as proof that no subsidy exists."
  ]
}
