{
  "schema_version": "1.0",
  "dictionary_id": "death_benefit_discovery",
  "dictionary_version": "0.1",
  "locale": "zh-TW",
  "user_facing_topic": "親人過世",
  "internal_topic": "死亡、喪葬與遺族",
  "purpose": "Discover and rank candidate government subsidy resources for later evidence review.",
  "scope": {
    "primary_resource_type": "subsidy",
    "include": [
      "政府提供的現金補助、津貼、慰問金或急難救助",
      "喪葬、安葬、火化或納骨相關費用補助",
      "與喪葬服務直接相關的費用或規費減免",
      "由政府補助或負擔、可降低家屬支出的實物或服務"
    ],
    "adjacent_review": [
      "社會保險死亡或喪葬給付",
      "遺屬年金或遺屬津貼",
      "撫卹、死亡補償或事故賠償"
    ],
    "exclude": [
      "沒有實質補助的死亡登記、除戶或證件註銷",
      "沒有本主題補助的遺產、繼承或稅務說明",
      "私人殯葬業者、商品、廣告或商業服務",
      "沒有申請資源的新聞、統計、研究或成果報告",
      "預算、決算、採購、招標或得標資料",
      "無法辨認具體資源或申請方式的單獨法規全文",
      "尚未另訂來源規則的民間募款或慈善資源"
    ]
  },
  "keyword_groups": {
    "event_terms": [
      "親人過世",
      "死亡",
      "身故",
      "過世",
      "亡故",
      "喪葬",
      "殯葬",
      "安葬",
      "埋葬",
      "火化",
      "納骨",
      "喪偶",
      "遺族",
      "遺屬",
      "遺眷"
    ],
    "subsidy_terms": [
      "補助",
      "補貼",
      "津貼",
      "救助",
      "扶助",
      "慰問金",
      "急難救助",
      "費用補助",
      "費用減免",
      "規費減免",
      "公費"
    ],
    "high_precision_phrases": [
      "喪葬補助",
