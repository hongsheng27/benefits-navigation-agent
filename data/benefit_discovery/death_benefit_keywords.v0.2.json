  "normalization": {
    "preserve_original_text": true,
    "collapse_whitespace_for_matching": true,
    "normalize_fullwidth_parentheses_for_matching": true,
    "character_variants_for_matching": [
      [
        "臺",
        "台"
      ]
    ],
    "canonical_term_aliases": {
      "撫卹": [
        "撫恤"
      ]
    },
    "rewrite_original_text": false,
    "convert_simplified_to_traditional": false,
    "simplified_script_action": "block_auto_approval_and_request_source_review",
    "match_high_precision_phrases_before_tokenization": true
  },
  "discovery_rules": [
    {
      "id": "R1_high_precision_subsidy",
      "when": "A content block matches high_precision_subsidy_phrases.",
      "result": "primary_support_candidate",
      "priority": "high"
    },
    {
      "id": "R2_government_service",
      "when": "A content block matches government_service_phrases.",
      "result": "government_service_candidate",
      "priority": "high"
    },
    {
      "id": "R3_funeral_service_and_assistance",
      "when": "The same content block matches funeral_service_terms and economic_assistance_terms.",
      "result": "primary_support_candidate",
      "priority": "normal"
    },
    {
      "id": "R4_death_event_and_assistance",
      "when": "The same content block matches death_event_low_precision and economic_assistance_terms.",
      "result": "weak_support_candidate",
      "priority": "low"
    },
    {
      "id": "R5_related_financial_phrase",
      "when": "A content block matches related_financial_phrases.",
      "result": "related_financial_candidate",
      "priority": "separate_review"
    },
    {
      "id": "R6_fee_schedule_discovery",
      "when": "The same content block matches funeral_service_terms and fee_schedule_terms.",
      "result": "fee_schedule_candidate",
      "priority": "normal",
      "note": "Do not classify as a fee waiver until a fee_relief_terms match is found."
    },
    {
      "id": "R7_fee_relief_confirmation",
      "when": "A fee_schedule_candidate block also matches fee_relief_terms.",
      "result": "fee_waiver_candidate",
      "priority": "high"
    },
    {
      "id": "R8_listing_expansion",
      "when": "A reviewed source is a benefit listing, service index, or fee schedule.",
      "result": "expand_child_links_or_content_blocks",
      "priority": "normal"
    }
  ],
  "routing_precedence": [
    "hard_exclusion",
    "government_service_candidate",
    "related_financial_candidate",
    "fee_waiver_candidate",
    "primary_support_candidate",
    "fee_schedule_candidate",
    "weak_support_candidate"
  ],
  "candidate_controls": {
    "hard_exclusion_rules": [
      "source_registry confirms a non-Taiwan government source",
      "source_registry confirms a commercial source",
      "source_registry classifies the source as procurement-only",
      "the candidate content block clearly identifies a non-human subject"
    ],
    "hard_exclusion_audit_fields": [
      "rule_id",
      "candidate_block",
      "matched_span",
      "source_registry_id",
      "decided_at"
    ],
    "soft_only_signals": [
      "news, statistics, research, budget, or final-account language",
      "simplified-script detection without confirmed jurisdiction",
      "application document terms that may also appear on real program pages"
    ],
    "deduplication_key": "canonical_url_and_content_identity"
  },
  "required_review_fields": {
    "expense_proof_requirement": [
      "required",
      "not_required",
      "conditional",
      "unknown"
    ],
    "text_with_evidence": [
      "claimant_rule_text",
      "deadline_rule_text",
      "mutual_exclusion_text"
    ],
    "evidence_metadata": [
      "source_url",
      "source_excerpt",
      "retrieved_at",
      "review_status"
    ]
  },
  "review_constraints": [
    "Keyword matches create candidates only.",
    "Do not infer current availability, user eligibility, or organization responsibility from keywords.",
    "A law or news page can provide evidence but does not become a benefit program by itself.",
    "Require official-source and human evidence review before publishing a program.",
    "Keep uncertain candidates instead of treating missing evidence as proof that no support exists.",
    "Connect organization roles to OIDs only after role evidence is reviewed."
  ]
}
