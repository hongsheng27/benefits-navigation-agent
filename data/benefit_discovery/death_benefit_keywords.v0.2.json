  "locale": "zh-TW",
  "user_facing_topic": "親人過世",
  "internal_topic": "死亡、喪葬與遺族",
  "purpose": "Discover and route candidate public resources for later official-evidence review.",
  "scope": {
    "geographies": [
      "central_government",
      "taipei_city"
    ],
    "primary": [
      "政府提供的死亡或喪葬補助與救助",
