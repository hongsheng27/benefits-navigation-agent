# Copy to .env for local development. Never commit real credentials.
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
VITE_API_BASE_URL=

# Approved Hackathon data-layer targets. These variables are not consumed until
# the PostgreSQL/S3 adapters are implemented and explicitly enabled. The object
# selector covers source documents and attachments; attachment rows additionally
# retain their own storage_backend metadata.
# DATA_STORE_BACKEND=sqlite
# RDS_HOST=
# RDS_PORT=5432
# RDS_DATABASE=
# RDS_USERNAME=
# RDS_PASSWORD=
# RDS_SSLMODE=require
# ATTACHMENT_STORAGE_BACKEND=local
# S3_BUCKET_NAME=
# S3_ATTACHMENT_PREFIX=attachments/
