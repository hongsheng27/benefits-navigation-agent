# Copy to .env for local development. Never commit real credentials.
#
# Competition AWS regions: us-east-1 and us-west-2 (primary).
AWS_REGION=us-west-2
# Workshop snippets may also set this; either name works.
AWS_DEFAULT_REGION=us-west-2

# Temporary AWS credentials from Workshop Studio → "Get AWS CLI credentials".
# Paste the three values here (no $Env: prefix). They expire; refresh when
# `aws sts get-caller-identity` starts failing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock (the only live language model provider).
# Leave empty to use the offline demo fixture (keyword fallback only).
# Haiku 4.5 needs an inference profile ID, not the bare foundation model ID.
# Verified in the competition account in us-west-2:
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional / unused by the current backend path.
BEDROCK_KNOWLEDGE_BASE_ID=
# Frontend → backend. Keep in sync with `make backend` (default port 8000).
# Also copy this line into frontend/.env (Vite only reads that file for VITE_*).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Data store backend: "sqlite" (local default) or "postgresql" (RDS deployment)
# Team default: use postgresql to connect to the shared RDS instance.
DATA_STORE_BACKEND=postgresql

# RDS PostgreSQL connection (used when DATA_STORE_BACKEND=postgresql)
# Host is the shared team RDS instance in us-west-2.
RDS_HOST=database-1.c54m4aak2pcn.us-west-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=benefits_navigation
RDS_USERNAME=benefits_admin
RDS_PASSWORD=benefits_admin
RDS_SSLMODE=require

# S3 document/attachment storage (used when ATTACHMENT_STORAGE_BACKEND=s3)
ATTACHMENT_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ATTACHMENT_PREFIX=attachments/
