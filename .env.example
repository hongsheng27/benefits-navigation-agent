# Copy to .env for local development. Never commit real credentials.
#
# Competition AWS regions: us-east-1 and us-west-2 (primary).
AWS_REGION=us-west-2
# Workshop snippets may also set this; either name works.
AWS_DEFAULT_REGION=us-west-2

# Temporary AWS credentials from Workshop Studio → "Get AWS CLI credentials".
# Paste the three values here (no $Env: prefix). They expire; refresh when
# `aws sts get-caller-identity` starts failing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock (preferred language model on competition day).
# Leave empty to fall back to Gemini, then to the offline demo.
# Haiku 4.5 needs an inference profile ID, not the bare foundation model ID.
# Example that works in the competition account:
# global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=

# Optional / unused by the current backend path.
BEDROCK_KNOWLEDGE_BASE_ID=

VITE_API_BASE_URL=

# Gemini fallback when Bedrock is not configured.
# Leave empty for competition demos that must use Bedrock only.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
