# Copy to .env for local development. Never commit real credentials.
#
# Competition AWS regions: us-east-1 and us-west-2 (primary).
AWS_REGION=us-east-1

# Bedrock (preferred language model on competition day).
# Leave empty to fall back to Gemini, then to the offline demo.
# Request access only for the model you will actually call.
# Example: anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=

# Optional / unused by the current backend path.
BEDROCK_KNOWLEDGE_BASE_ID=

# AWS credentials: use the normal AWS chain (environment variables,
# shared credentials file, or the competition account login).
# Never commit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.

VITE_API_BASE_URL=

# Gemini fallback when Bedrock is not configured.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
#
# Leave GEMINI_API_KEY empty and the backend falls back to an offline demo
# implementation instead of failing to start, so teammates without a key can
# still run the whole application. See ADR-0015.
GEMINI_API_KEY=
# Optional. Defaults to gemma-4-31b-it when unset.
GEMINI_MODEL_ID=
