# Copy to .env for local development. Never commit real credentials.
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
VITE_API_BASE_URL=

# Data store backend: "sqlite" (local default) or "postgresql" (RDS deployment)
DATA_STORE_BACKEND=sqlite

# RDS PostgreSQL connection (used when DATA_STORE_BACKEND=postgresql)
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=benefits_navigation
RDS_USERNAME=benefits_admin
RDS_PASSWORD=
RDS_SSLMODE=require

# S3 document/attachment storage (used when ATTACHMENT_STORAGE_BACKEND=s3)
ATTACHMENT_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ATTACHMENT_PREFIX=attachments/
