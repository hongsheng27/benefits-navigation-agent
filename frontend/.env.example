# Frontend environment variables (Vite only reads VITE_* prefixed vars).
# Copy this file to .env in the frontend/ directory.

# Backend API URL - for local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# For production (EC2 deployment), use the public IP:
# VITE_API_BASE_URL=http://35.88.159.212:8000
